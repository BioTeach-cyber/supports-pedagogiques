---
import { chemin } from '../Utils/Chemin.js';

const { titre, lien, image, couleur, pastille, classe } = Astro.props;
---
<a href={lien} class="vignette" data-classe={classe} style={`--theme: ${couleur}`}>
  <div class="image">
    {image && <img src={chemin(image)} alt="" loading="lazy" />}
    {pastille && <span class="pastille">{pastille}</span>}
  </div>
  <div class="titre">{titre}</div>
</a>

<style>
  .vignette {
    display: flex;
    flex-direction: column;
    aspect-ratio: 1;
    border: 3px solid var(--texte);
    border-radius: var(--rayon);
    overflow: hidden;
    text-decoration: none;
    background: white;
    transition: transform .2s, box-shadow .2s;
  }
  .vignette:hover { transform: translateY(-5px); box-shadow: 0 8px 18px #0003; }
  .image { flex: 1; position: relative; border-bottom: 3px solid var(--texte); }
  .image img { width: 100%; height: 100%; object-fit: cover; }
  .pastille {
    position: absolute; top: 10px; left: 10px;
    width: 47px; height: 47px; border-radius: 50%;
    background: white; border: 3px solid var(--texte);
    display: grid; place-items: center;
    font-weight: 700; font-size: 18px;
  }
  .titre {
    background: var(--theme);
    color: white; font-weight: 700; font-size: 18px;
    padding: 14px 10px; text-align: center;
    display: -webkit-box; -webkit-line-clamp: 2;
    -webkit-box-orient: vertical; overflow: hidden;   /* titre tronqué sur 2 lignes */
  }
  .vignette[hidden] { display: none; }
</style>