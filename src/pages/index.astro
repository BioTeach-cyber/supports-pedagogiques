---
import Base from '../Layouts/Base.astro';
import Vignette from '../Components/Vignette.astro';
import FiltreClasses from '../Components/FiltreClasses.astro';
import { chemin } from '../Utils/Chemin.js';
import cours from '../Data/Cours.json';
import blog from '../Data/Blog.json';
import formations from '../Data/Formations.json';
import site from '../Data/Site.json';

const articlesBlog: { titre: string; lien: string; image?: string }[] = blog;
const articlesFormation: { titre: string; lien: string; image?: string }[] = formations;
const coursActifs = cours.filter((c) => !c.archive);
const classes = [...new Set(coursActifs.map((c) => c.classe))];
---
<Base titre={site.titreAccueil} indexer={false}>

  <h2 class="banniere">Cours</h2>
  <FiltreClasses classes={classes} />
  <div class="grille" id="grille-cours">
    {coursActifs.map((c) => (
      <Vignette titre={c.titre} lien={chemin(`${c.id}/`)} image={c.image}
                couleur={c.couleur} pastille={c.niveau} classe={c.classe} />
    ))}
  </div>
  <a class="bouton" href={chemin('Archives/')}>Archives</a>

  <h2 class="banniere">Blog</h2>
  <div class="grille">
    {articlesBlog.slice(0, 5).map((a) => (
      <Vignette titre={a.titre} lien={chemin(a.lien)} image={a.image} couleur="#e62d32" />
    ))}
  </div>
  <a class="bouton" href={chemin('blog/')}>Voir plus</a>

  <h2 class="banniere">Formation</h2>
  <div class="grille">
    {articlesFormation.slice(0, 5).map((f) => (
      <Vignette titre={f.titre} lien={chemin(f.lien)} image={f.image} couleur="#e898b5" />
    ))}
  </div>
  <a class="bouton" href={chemin('formation/')}>Voir plus</a>

</Base>